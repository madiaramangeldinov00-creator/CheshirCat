<div class="modal modal-small modal-info fade" id="logIn" role="dialog">
	<div class="modal-dialog">
		<div class="modal-header modal-header-title">
			<h2>Войти на сайт</h2>
			<div class="title">
                <span>У вас нет аккаунта?</span>
                <a data-analytics="Login|Register" href="/personal/register/">Зарегистрируйтесь</a>
            </div>
			<a href="#" class="modal-close" data-dismiss="modal">Close</a>
		</div>
		<div class="modal-content">
            						<form method="post" action="/catalog/little-one-korm-dlya-krolikov/?login=yes" novalidate class="modal-form js-form">
								<input type="hidden" name="backurl" value="/catalog/little-one-korm-dlya-krolikov/" />
												<input type="hidden" name="AUTH_FORM" value="Y" />
				<input type="hidden" name="TYPE" value="AUTH" />
				<input type="hidden" name="popup_auth" value="Y" />
				<input type="hidden" name="USER_REMEMBER" value="Y" />

				<div class="form-group">
					<input type="text" class="form-control" name="USER_LOGIN" value="" placeholder="E-mail" data-validate="text">
				</div>
				<div class="form-group">
					<input type="password" class="form-control" name="USER_PASSWORD" placeholder="Пароль" data-validate="password">
				</div>
				<a data-analytics="Login|Forgot|#title#" href="#" class="btn pull-left sub-link js-link-forgot-password" data-dismiss="modal">Забыли пароль?</a>
				<button data-analytics="Login|Logged_in|#title#" type="submit" class="btn btn-success pull-right">Войти</button>
			</form>

		</div>
	</div>
</div>



